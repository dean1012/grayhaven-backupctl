def unique_prefix_lengths(snapshot_ids: Iterable[str]) -> dict[str, int]:
    ids = list(snapshot_ids)
    lengths: dict[str, int] = {}
    for snapshot_id in ids:
        length = MIN_SNAPSHOT_PREFIX
        while length < len(snapshot_id):
            prefix = snapshot_id[:length]
            if sum(other.startswith(prefix) for other in ids) == 1:
                break
            length += 1
        lengths[snapshot_id] = length
    return lengths


def resolve_operator_path(path_value: str) -> str:
    expanded = os.path.expandvars(os.path.expanduser(path_value))
    return os.path.abspath(expanded)


def read_requested_paths(args: argparse.Namespace) -> list[str]:
    paths = list(args.path or [])
    if args.path_file:
        try:
            for line in (
                pathlib.Path(args.path_file).read_text(encoding="utf-8").splitlines()
            ):
                stripped = line.strip()
                if stripped and not stripped.startswith("#"):
                    paths.append(stripped)
        except OSError as exc:
            raise GrayhavenBackupctlError(
                f"Unable to read path file {args.path_file}: {exc}"
            ) from exc
    if not paths:
        raise GrayhavenBackupctlError(
            "At least one --path or --path-file entry is required"
        )
    return [resolve_operator_path(path) for path in paths]


def probe_root_for_pattern(path: str) -> str:
    wildcard_positions = [
        pos for pos in (path.find("*"), path.find("?"), path.find("[")) if pos != -1
    ]
    if not wildcard_positions:
        return path
    first_wildcard = min(wildcard_positions)
    prefix = path[:first_wildcard]
    if "/" not in prefix.rstrip("/"):
        return "/"
    if prefix.endswith("/"):
        return prefix.rstrip("/") or "/"
    return str(pathlib.PurePosixPath(prefix).parent)


def first_matching_path(requested_path: str, listed_paths: list[str]) -> str | None:
    if has_glob(requested_path):
        for path in listed_paths:
            if fnmatch.fnmatch(path, requested_path):
                return path
        return None

    normalized = requested_path.rstrip("/") or "/"
    for path in listed_paths:
        if (path.rstrip("/") or "/") == normalized:
            return path
    return None


def has_glob(path: str) -> bool:
    return any(char in path for char in "*?[")


def snapshot_matches(reference: str, snapshot: Snapshot) -> bool:
    return snapshot.id.startswith(reference) or snapshot.short_id == reference


def repo_restore_priority(selector: str, repo_name: str) -> int:
    if selector == "all" and repo_name == "local":
        return 0
    if selector == "all" and repo_name == "remote":
        return 1
    return 0


def relative_tree(path: str) -> pathlib.Path:
    return pathlib.Path(path.lstrip("/"))


# ---------------------------------------------------------------------------
# Restore filesystem helpers
# ---------------------------------------------------------------------------


def confirm_overwrite(path: pathlib.Path) -> bool:
    """Confirm replacement of one conflicting archive entry."""

    response = input(f"Overwrite {path}? [y/N]: ")
    return response.lower() in {"y", "yes"}


def _archive_metadata(source: pathlib.Path, destination_fd: int) -> None:
    """Apply archived directory metadata through an already verified descriptor."""

    source_stat = source.lstat()
    os.fchown(destination_fd, source_stat.st_uid, source_stat.st_gid)
    os.fchmod(destination_fd, stat.S_IMODE(source_stat.st_mode))
    os.utime(destination_fd, ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns))


@contextlib.contextmanager
def _destination_parent(
    destination: pathlib.Path,
    source: pathlib.Path,
    source_root: pathlib.Path | None,
) -> Iterator[int]:
    """Walk and create destination ancestors without following symlinks."""

    absolute = pathlib.Path(os.path.abspath(destination))
    if absolute == pathlib.Path("/"):
        raise GrayhavenBackupctlError("Cannot restore over the filesystem root")

    archived_ancestors: dict[pathlib.Path, pathlib.Path] = {}
    if source_root is not None:
        relative_source = source.relative_to(source_root)
        destination_root = absolute
        for _ in relative_source.parts:
            destination_root = destination_root.parent
        for index in range(1, len(relative_source.parts)):
            relative_ancestor = pathlib.Path(*relative_source.parts[:index])
            archived_ancestors[destination_root / relative_ancestor] = (
                source_root / relative_ancestor
            )

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    current_fd = os.open("/", flags)
    current_path = pathlib.Path("/")
    try:
        for part in absolute.parts[1:-1]:
            current_path /= part
            created = False
            try:
                os.mkdir(part, mode=0o700, dir_fd=current_fd)
                created = True
            except FileExistsError:
                pass
            try:
                next_fd = os.open(part, flags, dir_fd=current_fd)
            except OSError as exc:
                raise GrayhavenBackupctlError(
                    f"Destination ancestor is not a safe directory: {current_path}"
                ) from exc
            os.close(current_fd)
            current_fd = next_fd
            if created and current_path in archived_ancestors:
                _archive_metadata(archived_ancestors[current_path], current_fd)
        yield current_fd
    finally:
        os.close(current_fd)


def _existing_entry(parent_fd: int, name: str) -> os.stat_result | None:
    try:
        return os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None


def _remove_conflicting_entry(parent_fd: int, name: str, mode: int) -> None:
    if stat.S_ISDIR(mode):
        # CPython uses descriptor-relative traversal on Linux, avoiding symlink
        # substitution while removing a directory that conflicts with a file.
        shutil.rmtree(name, dir_fd=parent_fd)
    else:
        os.unlink(name, dir_fd=parent_fd)


def _copy_regular_file(
    source: pathlib.Path, parent_fd: int, name: str, source_stat: os.stat_result
) -> None:
    temporary_name = f".backupctl-{secrets.token_hex(16)}"
    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        temporary_fd = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=parent_fd,
        )
        try:
            with (
                os.fdopen(source_fd, "rb", closefd=False) as source_file,
                os.fdopen(temporary_fd, "wb", closefd=False) as target_file,
            ):
                shutil.copyfileobj(source_file, target_file)
            os.fchown(temporary_fd, source_stat.st_uid, source_stat.st_gid)
            os.fchmod(temporary_fd, stat.S_IMODE(source_stat.st_mode))
            os.utime(
                temporary_fd,
                ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns),
            )
        finally:
            os.close(temporary_fd)
        os.replace(temporary_name, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
    finally:
        os.close(source_fd)
        if _existing_entry(parent_fd, temporary_name) is not None:  # pragma: no cover
            os.unlink(temporary_name, dir_fd=parent_fd)


def _copy_symlink(
    source: pathlib.Path, parent_fd: int, name: str, source_stat: os.stat_result
) -> None:
    temporary_name = f".backupctl-{secrets.token_hex(16)}"
    os.symlink(os.readlink(source), temporary_name, dir_fd=parent_fd)
    try:
        os.chown(
            temporary_name,
            source_stat.st_uid,
            source_stat.st_gid,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        os.utime(
            temporary_name,
            ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns),
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        os.replace(temporary_name, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
    finally:
        if _existing_entry(parent_fd, temporary_name) is not None:  # pragma: no cover
            os.unlink(temporary_name, dir_fd=parent_fd)


def _merge_entry(
    source: pathlib.Path,
    parent_fd: int,
    name: str,
    destination: pathlib.Path,
    force: bool,
) -> bool:
    source_stat = source.lstat()
    existing = _existing_entry(parent_fd, name)
    source_directory = stat.S_ISDIR(source_stat.st_mode)
    existing_directory = existing is not None and stat.S_ISDIR(existing.st_mode)
    if existing is not None and not (source_directory and existing_directory):
        if not force and not confirm_overwrite(destination):
            return False
        if existing_directory:
            _remove_conflicting_entry(parent_fd, name, existing.st_mode)
            existing = None

    if source_directory:
        if existing is None or not existing_directory:
            if existing is not None:
                _remove_conflicting_entry(parent_fd, name, existing.st_mode)
            os.mkdir(name, mode=0o700, dir_fd=parent_fd)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
        child_fd = os.open(name, flags, dir_fd=parent_fd)
        try:
            for child in sorted(source.iterdir()):
                _merge_entry(
                    child, child_fd, child.name, destination / child.name, force
                )
            _archive_metadata(source, child_fd)
        finally:
            os.close(child_fd)
    elif stat.S_ISREG(source_stat.st_mode):
        _copy_regular_file(source, parent_fd, name, source_stat)
    elif stat.S_ISLNK(source_stat.st_mode):
        _copy_symlink(source, parent_fd, name, source_stat)
    else:  # pragma: no cover
        raise GrayhavenBackupctlError(f"Unsupported archived file type: {source}")
    restore_selinux_context(destination)
    return True


def copy_restored_path(
    source: pathlib.Path,
    destination: pathlib.Path,
    overwrite: bool,
    source_root: pathlib.Path | None = None,
) -> bool:
    with _destination_parent(destination, source, source_root) as parent_fd:
        restored = _merge_entry(
            source, parent_fd, destination.name, destination, overwrite
        )
    return restored


def restore_selinux_context(path: pathlib.Path) -> None:
    """Restore SELinux labels after copying restored files into place."""

    if not selinux.is_selinux_enabled():
        return
    try:
        selinux.matchpathcon(os.path.abspath(path), 0)
    except FileNotFoundError:
        return
    selinux.selinux_restorecon(
        os.path.abspath(path), selinux.SELINUX_RESTORECON_IGNORE_NOENTRY
    )


# ---------------------------------------------------------------------------
# Output formatting
# ---------------------------------------------------------------------------


def print_snapshots(snapshots: list[Snapshot]) -> None:
    if not snapshots:
        print("No backups found")
        return

    rows = [
        ("REPO", "SNAPSHOT", "TIME", "HOST", "PATHS"),
        *[
            (
                snapshot.repo,
                snapshot.short_id,
                format_timestamp(snapshot.time),
                snapshot.host,
                ", ".join(snapshot.paths),
            )
            for snapshot in snapshots
        ],
    ]
    print_table(rows)


def print_matches(matches: list[PathMatch]) -> None:
    if not matches:
        print("No matching backups found")
        return

    rows = [
        ("PATH", "REPO", "SNAPSHOT", "TIME", "MATCH"),
        *[
            (
                match.requested_path,
                match.repo.name,
                match.snapshot.short_id,
                format_timestamp(match.snapshot.time),
                match.matched_path,
            )
            for match in matches
        ],
    ]
    print_table(rows)


def print_paths(paths: list[str]) -> None:
    if not paths:
        print("No paths found")
        return
    for path in paths:
        print(path)


def print_table(rows: Sequence[Sequence[str]]) -> None:
    widths = [max(len(row[index]) for row in rows) for index in range(len(rows[0]))]
    for row_index, row in enumerate(rows):
        print("  ".join(value.ljust(widths[index]) for index, value in enumerate(row)))
        if row_index == 0:
            print("  ".join("-" * width for width in widths))


# ---------------------------------------------------------------------------
# Shell completion
# ---------------------------------------------------------------------------


def bash_completion_script() -> str:
    """Return bash completion for operator-facing command options."""

    return r"""# bash completion for grayhaven-backupctl
_grayhaven_backupctl()
{
    local cur prev words cword command
    _init_completion || return

    local global_opts="--verbose --help"
    local commands="list ls find restore backup completion"
    local find_opts="--repo --path --path-file --since --until --help"
    local repos="all local remote"
    local restore_opts="--repo --path --path-file --since --until --as-of"
    restore_opts="$restore_opts --target --in-place --force --help"

    command=""
    for word in "${words[@]:1:cword-1}"; do
        case "$word" in
            list|ls|find|restore|backup|completion)
                command="$word"
                break
                ;;
        esac
    done

    case "$prev" in
        --repo)
            COMPREPLY=( $(compgen -W "$repos" -- "$cur") )
            return
            ;;
        --since|--until|--as-of)
            return
            ;;
        --path|--path-file|--target)
            _filedir
            return
            ;;
    esac

    if [[ -z "$command" ]]; then
        COMPREPLY=( $(compgen -W "$global_opts $commands" -- "$cur") )
        return
    fi

    case "$command" in
        list)
            COMPREPLY=( $(compgen -W "--repo --since --until --help" -- "$cur") )
            ;;
        ls)
            COMPREPLY=( $(compgen -W "--repo --path --recursive --help" -- "$cur") )
            ;;
        find)
            COMPREPLY=( $(compgen -W "$find_opts" -- "$cur") )
            ;;
        restore)
            COMPREPLY=( $(compgen -W "$restore_opts" -- "$cur") )
            ;;
        backup)
            COMPREPLY=( $(compgen -W "--repo --help" -- "$cur") )
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash --help" -- "$cur") )
            ;;
    esac
}
complete -F _grayhaven_backupctl grayhaven-backupctl
"""


# ---------------------------------------------------------------------------
# Command-line parser
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="grayhaven-backupctl",
        description="Manage Grayhaven local and remote restic backups.",
    )
    parser.add_argument(
        "--verbose", action="store_true", help="show detailed command feedback"
    )

    subparsers = parser.add_subparsers(dest="command")

    list_parser = subparsers.add_parser("list", help="list available backups")
    add_repo_option(list_parser)
    add_time_options(list_parser)

    ls_parser = subparsers.add_parser("ls", help="list files in a backup")
    ls_parser.add_argument(
        "snapshot", nargs="?", default="latest", help="snapshot ID or latest"
    )
    ls_parser.add_argument("--path", required=True, help="file or directory to list")
    ls_parser.add_argument(
        "--recursive", action="store_true", help="list directory contents recursively"
    )
    add_repo_option(ls_parser)

    find_parser = subparsers.add_parser("find", help="find backups containing paths")
    add_repo_option(find_parser)
    add_path_options(find_parser)
    add_time_options(find_parser)

    restore_parser = subparsers.add_parser(
        "restore", help="restore files or directories"
    )
    restore_parser.add_argument(
        "snapshot", nargs="?", default="latest", help="snapshot ID or latest"
    )
    add_repo_option(restore_parser)
    add_path_options(restore_parser)
    add_time_options(restore_parser)
    restore_parser.add_argument(
        "--as-of",
        help=(
            "restore from the closest matching backup at or before a time "
            'such as "3 days ago"'
        ),
    )
    target_group = restore_parser.add_mutually_exclusive_group()
    target_group.add_argument("--target", help="restore under this directory")
    target_group.add_argument(
        "--in-place", action="store_true", help="restore to original paths"
    )
    restore_parser.add_argument(
        "--force", action="store_true", help="overwrite without prompting"
    )

    backup_parser = subparsers.add_parser("backup", help="create a new backup")
    add_repo_option(backup_parser)

    completion_parser = subparsers.add_parser(
        "completion", help="print shell completion script"
    )
    completion_parser.add_argument(
        "shell", choices=("bash",), help="shell to generate completion for"
    )

    return parser


def add_repo_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--repo",
        choices=("all", "local", "remote"),
        default="all",
        help="repository to use (default: all)",
    )


def add_time_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--since", help='include backups since a time such as "2 days ago"'
    )
    parser.add_argument(
        "--until", help='include backups until a time such as "2026-06-27 8:00 AM"'
    )


def add_path_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--path", action="append", help="file, directory, or glob to process"
    )
    parser.add_argument("--path-file", help="file containing one path per line")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if arguments == ["--version"]:
        try:
            print(package_version())
        except GrayhavenBackupctlError as exc:
            print(f"grayhaven-backupctl: {exc}", file=sys.stderr)
            return 1
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return 0

    try:
        if args.command == "completion":
            if args.shell == "bash":
                print(bash_completion_script(), end="")
            return 0

        service = BackupService(BackupConfig.from_backup_script())
        if args.command == "list":
            print_snapshots(
                service.snapshots(
                    args.repo,
                    since=parse_human_time(args.since),
                    until=parse_human_time(args.until),
                )
            )
        elif args.command == "ls":
            requested_path = resolve_operator_path(args.path)
            matches = service.find_matches(args.repo, [requested_path])
            selected = next(
                (
                    match
                    for match in matches
                    if args.snapshot == "latest"
                    or snapshot_matches(args.snapshot, match.snapshot)
                ),
                None,
            )
            if selected is None:
                raise GrayhavenBackupctlError(
                    f"No {args.repo} snapshot contains {requested_path}"
                )
            print_paths(
                service.list_snapshot_contents(
                    selected.repo,
                    selected.snapshot.id,
                    selected.matched_path,
                    recursive=args.recursive,
                )
            )
        elif args.command == "find":
            requested_paths = read_requested_paths(args)
            print_matches(
                service.find_matches(
                    args.repo,
                    requested_paths,
                    since=parse_human_time(args.since),
                    until=parse_human_time(args.until),
                )
            )
        elif args.command == "restore":
            requested_paths = read_requested_paths(args)
            target_dir = (
                pathlib.Path.cwd()
                if args.target is None
                else pathlib.Path(os.path.abspath(args.target))
            )
            if args.as_of and args.until:
                raise GrayhavenBackupctlError(
                    "--as-of and --until cannot be used together"
                )
            if args.as_of and args.snapshot != "latest":
                raise GrayhavenBackupctlError(
                    "--as-of can only be used with latest restore selection"
                )
            since = parse_human_time(args.since)
            until = (
                parse_human_time(args.as_of)
                if args.as_of
                else parse_human_time(args.until)
            )
            plan = service.resolve_restore_plan(
                args.repo,
                args.snapshot,
                requested_paths,
                target_dir,
                args.in_place,
                since=since,
                until=until,
            )
            service.restore(plan, force=args.force, verbose=args.verbose)
        elif args.command == "backup":
            service.backup(args.repo, verbose=args.verbose)
    except GrayhavenBackupctlError as exc:
        print(f"grayhaven-backupctl: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
