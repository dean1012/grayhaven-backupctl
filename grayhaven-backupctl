BACKUP_SCRIPT = pathlib.Path("/usr/local/sbin/grayhaven-restic-backup")
DEFAULT_CONFIG_PATH = pathlib.Path("/usr/local/sbin/grayhaven-restic-backup")
RESTIC_METRICS_PATH = pathlib.Path(
    "/var/lib/grayhaven/observability/textfile/restic.prom"
)
MIN_SNAPSHOT_PREFIX = 8
RESTIC_REPOSITORY_METRIC_PATTERN = re.compile(
    r"^grayhaven_restic_repository_last_success_timestamp_seconds"
    r'\{host="([^"]+)",repository="([^"]+)"\}\s+([0-9]+(?:\.[0-9]+)?)$'
)
VERSION_PATH = pathlib.Path(__file__).resolve().with_name("VERSION")
GIT_EXECUTABLE = "/usr/bin/git"
SEMANTIC_VERSION_PATTERN = re.compile(
    r"\A(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\Z"
)
VERSION_FILE_PATTERN = re.compile(
    r"\A(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\n\Z"
)


def parse_semantic_version(version: str) -> tuple[int, int, int]:
    """Parse a strict three-component semantic version."""

    match = SEMANTIC_VERSION_PATTERN.fullmatch(version)
    if not match:
        raise GrayhavenBackupctlError(
            f"Malformed semantic version {version!r}; expected MAJOR.MINOR.BUILD"
        )
    return (int(match.group(1)), int(match.group(2)), int(match.group(3)))


def read_version(path: pathlib.Path = VERSION_PATH) -> str:
    """Read the repository version, requiring exactly one newline."""

    try:
        content = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise GrayhavenBackupctlError(
            f"Unable to read VERSION from {path}: {exc}"
        ) from exc
    if not VERSION_FILE_PATTERN.fullmatch(content):
        raise GrayhavenBackupctlError(
            f"Malformed VERSION in {path}; expected exactly MAJOR.MINOR.BUILD "
            "followed by one newline"
        )
    return content[:-1]


def increment_build(version: str) -> str:
    """Increment the build component of a semantic version."""

    major, minor, build = parse_semantic_version(version)
    return f"{major}.{minor}.{build + 1}"


def renumber_version_history(versions: Sequence[str]) -> list[str]:
    """Renumber every retained work commit to the next build in history order."""

    corrected: list[str] = []
    for version in versions:
        parse_semantic_version(version)
        corrected.append(version if not corrected else increment_build(corrected[-1]))
    return corrected


COMMIT_METADATA_PATH = pathlib.Path(__file__).resolve().with_name("COMMIT_SHA")
FULL_COMMIT_SHA_PATTERN = re.compile(r"\A[0-9a-f]{40}\n\Z")


def resolve_short_sha(
    repo_path: pathlib.Path | None = None,
    metadata_path: pathlib.Path | None = None,
) -> str:
    """Resolve checkout HEAD or trusted adjacent full-commit metadata."""

    checkout_path = repo_path or VERSION_PATH.parent
    installed_metadata_path = metadata_path or COMMIT_METADATA_PATH

    try:
        # The executable and every argv token are fixed constants; no untrusted
        # input reaches subprocess execution.
        result = subprocess.run(  # noqa: S603
            [GIT_EXECUTABLE, "rev-parse", "--short", "HEAD"],
            cwd=checkout_path,
            check=True,
            text=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError):
        short_sha = ""
    else:
        short_sha = result.stdout.strip()
    if re.fullmatch(r"[0-9a-f]{7,40}", short_sha):
        return short_sha

    try:
        metadata = installed_metadata_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise GrayhavenBackupctlError(
            "Unable to determine commit short SHA: no valid Git checkout or "
            f"adjacent {installed_metadata_path.name} metadata"
        ) from exc
    if not FULL_COMMIT_SHA_PATTERN.fullmatch(metadata):
        raise GrayhavenBackupctlError(
            f"Malformed {installed_metadata_path.name}; expected exactly 40 "
            "lowercase hexadecimal characters followed by one newline"
        )
    return metadata[:-1][:7]


def format_version(version: str, short_sha: str) -> str:
    """Format the operator-facing package version."""

    parse_semantic_version(version)
    if not re.fullmatch(r"[0-9a-f]{7,40}", short_sha):
        raise GrayhavenBackupctlError(f"Malformed commit short SHA {short_sha!r}")
    return f"grayhaven-backupctl {version}-{short_sha}"


def package_version() -> str:
    """Return the operator-facing version and checkout identity."""

    return format_version(
        read_version(VERSION_PATH),
        resolve_short_sha(VERSION_PATH.parent, COMMIT_METADATA_PATH),
    )


